<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PKHeX.Core" Version="26.10.18" />
  </ItemGroup>

  <!-- The Android build puts its output elsewhere; never compile a desktop build's generated files. -->
  <ItemGroup>
    <Compile Remove="obj/**;bin/**" />
  </ItemGroup>

</Project>

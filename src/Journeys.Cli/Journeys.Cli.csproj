<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Journeys.Core\Journeys.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>journeys</AssemblyName>
    <RootNamespace>Journeys.Cli</RootNamespace>
  </PropertyGroup>

  <!-- The Android build puts its output elsewhere; never compile a desktop build's generated files. -->
  <ItemGroup>
    <Compile Remove="obj/**;bin/**" />
  </ItemGroup>

</Project>
